# Auto-detect text files, normalize to LF in the repo
* text=auto eol=lf

# Documents
*.md    text diff=markdown
*.MD    text diff=markdown
*.txt   text

# Serialisation
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Scripts
*.mjs   text eol=lf
*.js    text eol=lf

# Lock files — hide from PR diffs / language stats
package-lock.json  linguist-generated

# Git meta — never needed outside the repo
.gitattributes  export-ignore
.gitignore      export-ignore

# Dev-only directories/files specific to this repo
.github/        export-ignore
.githooks/      export-ignore
.claude/        export-ignore
