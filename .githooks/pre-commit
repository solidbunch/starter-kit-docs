#!/bin/sh
# Runs two offline checks and blocks the commit if either fails. Both always run, so a failure
# in the first never hides the second.
#
# 1. scripts/check-title-drift.mjs: index.md's TOC text must match each linked file's own
#    `# heading` (the file's heading is the published WordPress title — see
#    scripts/lib/manifest.mjs's docblock). Only parses Markdown locally, no WP credentials.
# 2. scripts/check-doc-claims.mjs: checkable claims in the docs (paths, names, ...) are verified
#    against a checkout of starter-kit-foundation. The foundation is found via FOUNDATION_PATH,
#    else ../starter-kit-foundation.loc next to this checkout, else next to the main checkout
#    (so it also works in git worktrees). Without a foundation checkout it prints a WARNING and
#    passes; DOC_CLAIMS_REQUIRE_FOUNDATION=1 turns that into a failure. The environment is
#    passed through to the checker unchanged.
#
# Not auto-installed by `git clone` — git only runs hooks from `.git/hooks` by default, which
# isn't versioned. Enable once per checkout with:
#   git config core.hooksPath .githooks

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root/scripts"

if [ ! -d node_modules ]; then
  echo "pre-commit: scripts/node_modules missing — run 'cd scripts && npm ci' once, then retry." >&2
  exit 1
fi

status=0
node check-title-drift.mjs || status=1
node check-doc-claims.mjs || status=1
exit "$status"
