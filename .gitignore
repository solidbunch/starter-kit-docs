#===================================#
#   No HTML is ever committed here  #
#===================================#
# This is a docs repo — content lives in Markdown, converted to Gutenberg block markup only at
# sync time. Generated markup lives in the gitignored .sync-output/ above, or on the WordPress
# site itself; it is never a committed artifact (see
# .claude/plans/architect-plan-docs-fixtures-and-ci-pipeline.md, Decision 1).
*.html


# ===================================#
#          Claude Code               #
# ===================================#
# Keep shared AI instructions tracked (root CLAUDE.md, .claude/rules/);
# ignore machine-local runtime artifacts.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/rules/
!.claude/commands/
!.claude/output-styles/
!.claude/workflows/
!.claude/settings.json
.playwright-mcp/
